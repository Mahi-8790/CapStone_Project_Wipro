<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cucumber Test Suite" verbose="1" parallel="false">

    <!-- Test for Cucumber Runner -->
    <test name="Cucumber Runner Test">
        <classes>
            <class name="TestRunner.cucumberTestrunner"/>
        </classes>
    </test>

    <!-- Test for Step Definitions -->
    <test name="Step Definitions Tests">
        <packages>
            <!-- This will include ALL classes inside StepDefination package -->
            <package name="StepDefination"/>
        </packages>
    </test>

</suite>